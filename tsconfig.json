{
  "extends": "@openspace/shared-configs/tsconfig.vite.json",

  "compilerOptions": {
    // The type generation script and the tests run in Node through `tsx`
    "types": ["vite/client", "node"],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["node_modules"]
}
